    "PATCH /sensors/{sensor_id}/thresholds": {"test_files": ["tests/test_telemetria_range.py"], "expected_output": [{"scenario": "Complete-bound validation and idempotent update", "expected": {"statuses": [200, 401, 422], "postcondition": "invalid patch preserves policy and historical alerts; repeated valid patch is stable"}}]},
