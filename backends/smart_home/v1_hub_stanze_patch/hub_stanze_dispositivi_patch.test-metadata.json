    "DELETE /hubs/{hub_id}": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Empty deletion and child-relation conflict", "expected": {"statuses": [204, 401, 404, 409], "postcondition": "conflict retains hub, room, device, and revisions"}}]},
    "GET /rooms": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Hub-scoped room list", "expected": {"statuses": [200, 401, 404], "postcondition": "ascending room page and no topology mutation"}}]},
    "POST /rooms": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Floor bounds, case-insensitive uniqueness, and ownership", "expected": {"statuses": [201, 401, 403, 409], "headers": ["Location", "ETag"], "json_contains": {"revision": 1}, "postcondition": "duplicate or forbidden write retains room"}}]},
    "GET /rooms/{room_id}": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Room retrieval and unchanged revision", "expected": {"statuses": [200, 401, 404], "headers": ["ETag"], "postcondition": "read has no persistent effect"}}]},
    "PATCH /rooms/{room_id}": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Floor patch with current and stale ETag", "expected": {"statuses": [200, 401, 409, 422], "headers": ["ETag"], "postcondition": "success advances only room revision; stale/empty patch preserves it"}}]},
    "DELETE /rooms/{room_id}": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Empty room deletion versus assigned-device conflict", "expected": {"statuses": [204, 401, 409], "postcondition": "conflict preserves room and device relation"}}]},
    "GET /devices": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Hub and unassigned filters", "expected": {"statuses": [200, 401, 404, 422], "postcondition": "filtered device page remains read-only"}}]},
    "POST /devices": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Assigned and unassigned device creation plus duplicate label", "expected": {"statuses": [201, 401, 409], "headers": ["Location", "ETag"], "json_contains": {"revision": 1}, "postcondition": "duplicate write leaves topology unchanged"}}]},
    "GET /devices/{device_id}": {"test_files": ["tests/test_hub_stanze_patch.py"], "expected_output": [{"scenario": "Owner and foreign device read", "expected": {"statuses": [200, 401, 403], "headers": ["ETag"], "postcondition": "foreign read changes nothing"}}]},
